# Copy to .env and fill in whichever you have. Any one is enough.
# The decision cache means a completed run is banked permanently, so a quota
# wall on one provider is an inconvenience, not a blocker.

# Free, generous, no card:  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free, very fast, per-minute limits:  https://console.groq.com/keys
GROQ_API_KEY=

# Free tier ~1,500 decisions per window:  https://ollama.com
OLLAMA_API_KEY=

# Paid:  https://console.anthropic.com
ANTHROPIC_API_KEY=
