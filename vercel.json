{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix web/client install && npm --prefix web/client run build",
  "outputDirectory": "web/client/dist",
  "installCommand": "echo 'deps installed by buildCommand'",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/|data/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
